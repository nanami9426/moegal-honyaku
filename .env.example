DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3-max
CUSTOM_API_KEY=
CUSTOM_BASE_URL=https://api.deepseek.com
CUSTOM_MODEL=deepseek-flash
MOEGAL_USE_GPU=0

# 擦字：纯色气泡自动填充背景色，其余区域使用 opencv 或可选的 lama。
# 仅作为启动默认值；前端配置面板可在运行时切换。
INPAINT_BACKEND=opencv
# LaMa 需另行下载 TorchScript 权重；相对路径以项目根目录为准。
INPAINT_LAMA_MODEL_PATH=assets/models/lama/big-lama.pt

# 模型下载：若镜像连接慢，可将主源和备用源互换。
HF_ENDPOINT=https://hf-mirror.com
HF_FALLBACK_ENDPOINT=https://huggingface.co
# 同时下载的文件数，范围 1～8；网络不稳定时可改为 1。
MODEL_DOWNLOAD_WORKERS=2
