DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3-max
CUSTOM_API_KEY=
CUSTOM_BASE_URL=https://api.deepseek.com
CUSTOM_MODEL=deepseek-flash
MOEGAL_USE_GPU=0
# 自动预翻译的资源限制；多个图片和标签页共用后端限额。
IMAGE_TRANSLATE_CONCURRENCY=3
OCR_MAX_CONCURRENCY=2
TRANSLATE_API_CONCURRENCY=8

# 模型下载：若镜像连接慢，可将主源和备用源互换。
HF_ENDPOINT=https://hf-mirror.com
HF_FALLBACK_ENDPOINT=https://huggingface.co
# 同时下载的文件数，范围 1～8；网络不稳定时可改为 1。
MODEL_DOWNLOAD_WORKERS=2
